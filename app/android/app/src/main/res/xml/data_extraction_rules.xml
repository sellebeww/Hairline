<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright (c) 2026 Vassel Goleyu. MIT License.
     Photos and measurements stay on the phone (CLAUDE.md 5.8): excluded from cloud backup and
     from device-to-device transfer. android:allowBackup="false" covers Android 11 and below. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
